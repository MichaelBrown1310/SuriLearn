# ==========================================
# SURILEARN - Variables de Entorno de Cliente (Públicas en SPA)
# Plan Spark / Firebase Web SDK
# ==========================================

VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto-surilearn.firebaseapp.com
